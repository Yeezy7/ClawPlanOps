{
  "id": "claw-planops",
  "name": "ClawPlanOps",
  "version": "0.2.0",
  "description": "基于交付物证据的项目执行规划插件。输入任务通知 → 自动解析要求 → 生成计划 → 导出日历 → 检查真实进度 → 动态重排。",
  "enabledByDefault": true,
  "activation": {
    "onStartup": false
  },
  "skills": [
    "./skills"
  ],
  "contracts": {
    "tools": [
      "clawplanops_parse_task_requirements",
      "clawplanops_build_deliverable_plan",
      "clawplanops_generate_calendar_schedule",
      "clawplanops_check_progress_evidence",
      "clawplanops_generate_daily_progress_report",
      "clawplanops_reschedule_plan"
    ]
  },
  "toolMetadata": {
    "clawplanops_parse_task_requirements": {
      "configSignals": []
    },
    "clawplanops_build_deliverable_plan": {
      "configSignals": []
    },
    "clawplanops_generate_calendar_schedule": {
      "configSignals": []
    },
    "clawplanops_check_progress_evidence": {
      "configSignals": []
    },
    "clawplanops_generate_daily_progress_report": {
      "configSignals": []
    },
    "clawplanops_reschedule_plan": {
      "configSignals": []
    }
  },
  "commandAliases": [
    {
      "name": "clawplanops",
      "kind": "runtime-slash",
      "cliCommand": "claw-planops"
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "outputDir": {
        "type": "string",
        "description": "输出目录，默认为 ./output"
      },
      "preferredWorkTime": {
        "type": "string",
        "description": "默认每日工作时间段，如 20:00-22:00"
      },
      "dailyAvailableHours": {
        "type": "number",
        "description": "每日可用小时数，默认 2"
      }
    }
  }
}
