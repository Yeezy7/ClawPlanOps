{
  "id": "claw-planops",
  "name": "ClawPlanOps",
  "version": "0.4.0",
  "description": "基于交付物证据的项目执行规划插件。输入任务通知 → 自动解析要求 → 生成计划 → 导出日历 → 检查真实进度 → 动态重排。支持周报生成、提交前检查、多任务并行、提醒推送、Git 关联、历史追踪、跨平台日历。",
  "enabledByDefault": true,
  "activation": {
    "onStartup": false
  },
  "skills": [
    "./skills"
  ],
  "contracts": {
    "tools": [
      "clawplanops_parse_task_requirements",
      "clawplanops_build_deliverable_plan",
      "clawplanops_generate_calendar_schedule",
      "clawplanops_check_progress_evidence",
      "clawplanops_generate_daily_progress_report",
      "clawplanops_reschedule_plan",
      "clawplanops_generate_weekly_report",
      "clawplanops_pre_submission_check",
      "clawplanops_multi_project_status",
      "clawplanops_git_task_link",
      "clawplanops_progress_trend",
      "clawplanops_send_notification",
      "clawplanops_cross_platform_calendar"
    ]
  },
  "toolMetadata": {
    "clawplanops_parse_task_requirements": { "configSignals": [] },
    "clawplanops_build_deliverable_plan": { "configSignals": [] },
    "clawplanops_generate_calendar_schedule": { "configSignals": [] },
    "clawplanops_check_progress_evidence": { "configSignals": [] },
    "clawplanops_generate_daily_progress_report": { "configSignals": [] },
    "clawplanops_reschedule_plan": { "configSignals": [] },
    "clawplanops_generate_weekly_report": { "configSignals": [] },
    "clawplanops_pre_submission_check": { "configSignals": [] },
    "clawplanops_multi_project_status": { "configSignals": [] },
    "clawplanops_git_task_link": { "configSignals": [] },
    "clawplanops_progress_trend": { "configSignals": [] },
    "clawplanops_send_notification": { "configSignals": [] },
    "clawplanops_cross_platform_calendar": { "configSignals": [] }
  },
  "commandAliases": [
    {
      "name": "clawplanops",
      "kind": "runtime-slash",
      "cliCommand": "claw-planops"
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "outputDir": {
        "type": "string",
        "description": "输出目录，默认为 ./output"
      },
      "preferredWorkTime": {
        "type": "string",
        "description": "默认每日工作时间段，如 20:00-22:00"
      },
      "dailyAvailableHours": {
        "type": "number",
        "description": "每日可用小时数，默认 2"
      }
    }
  }
}
